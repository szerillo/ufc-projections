+def bp_start(a, b, date):
+    """BettingPros scheduled_utc for a bout from the repo's data/*_odds.json files (both names, event date -1..+1), else None."""
+    global _BP_SCHED
+    if _BP_SCHED is None:
+        _BP_SCHED = []
+        for fp in sorted(glob.glob(str(REPO / "data" / "*_odds.json"))):
+            try:
+                for f in json.load(open(fp)).get("fights", []):
+                    t = _utc(f.get("scheduled_utc"))
+                    if t:
+                        _BP_SCHED.append((t, f["fighter_a"]["name"], f["fighter_b"]["name"]))
+            except Exception:
+                continue
+    if date is None:
+        return None
+    for t, x, y in _BP_SCHED:
+        if abs((t.date() - date).days) <= 1 and pair_match(a, b, x, y)[0] >= 1:
+            return t.strftime("%Y-%m-%dT%H:%M:%SZ")
+    return None
+
+
+def start_cut(snaps, sched=None):
+    """Kirk round 13 (Earlier_Start_PREREG sha 5c667602): the earliest start estimate on file. E1 = commence on the last
+    snapshot; E2 = BettingPros scheduled_utc if known; E3 = earliest commence on any snapshot within 12 h before E1."""
+    e1 = _utc(snaps[-1]["start"])
+    if e1 is None:
+        return None
+    ests = [e1]
+    for s in snaps:
+        c = _utc(s.get("start"))
+        if c and e1 - dt.timedelta(hours=12) <= c <= e1:
+            ests.append(c)
+    e2 = _utc(sched) if sched else None
+    if e2:
+        ests.append(e2)
+    return min(ests)
+
